# ==== Django (backend) ====
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=True
DATABASE_URL=postgres://documind_user:documind_pass@localhost:5432/documind
# Production only — comma-separated list of your real domains, e.g.:
# DJANGO_ALLOWED_HOSTS=your-backend.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-backend.onrender.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=

# Internal service-to-service auth (Django -> FastAPI)
FASTAPI_INTERNAL_KEY=changeme-shared-secret
FASTAPI_BASE_URL=http://localhost:8001

# ==== FastAPI (ai-service) ====
# Same DATABASE_URL as above — ai-service reads/writes vector data in the same Postgres (pgvector)

# Option A: OpenAI (real API, costs money per request — best quality/speed)
#   LLM_API_KEY=sk-your-real-openai-key
#   EMBEDDING_API_KEY=sk-your-real-openai-key
#   LLM_BASE_URL=https://api.openai.com/v1
#   EMBEDDING_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#   EMBEDDING_MODEL=text-embedding-3-small
#   EMBEDDING_DIMENSIONS=1536

# Option B: Ollama (free, runs LOCALLY ONLY — cannot be used for a deployed
# app, since most hosting doesn't have the CPU/RAM to run a local model)
#   ollama pull llama3
#   ollama pull nomic-embed-text
#   LLM_API_KEY=ollama
#   EMBEDDING_API_KEY=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   EMBEDDING_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3
#   EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_DIMENSIONS=768

# Option C: Groq (chat) + Google Gemini (embeddings) — FREE, and works when
# actually deployed, since both are hosted APIs (no local model needed).
# Get a Groq key at console.groq.com (free, no card) and a Gemini key at
# aistudio.google.com (free tier).
# NOTE: the older Gemini model "text-embedding-004" was shut down on
# 2026-01-14 — use gemini-embedding-001, which outputs 3072 dimensions.
# EMBEDDING_DIMENSIONS must exactly match the model's output size, and
# the database table is created with that size on first startup.
LLM_API_KEY=your-groq-api-key
EMBEDDING_API_KEY=your-gemini-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=3072

# ==== Object storage (fill in once file persistence on your host becomes a concern) ====
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
